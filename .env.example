NODE_ENV=local # Options: local, development, production

# Note: All other configuration (Database, JWT, etc.) is fetched from
# Firebase Remote Config during application startup for non-local environments.

# Telegram admin notifications — for local dev, set directly (or LOCAL_-prefixed).
# In development/production these are expected in Firebase Remote Config as
# DEV_TELEGRAM_BOT_TOKEN/DEV_TELEGRAM_CHAT_ID or PROD_TELEGRAM_BOT_TOKEN/PROD_TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
