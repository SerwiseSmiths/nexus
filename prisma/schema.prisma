generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Existing Enums ───────────────────────────────────────────────────────────

enum Role {
  PROVIDER
  CUSTOMER
  ADMIN
}

enum DeviceType {
  MASTER_PURIFIER
  AIR_CONDITIONER
  FRIDGE
  WASHING_MACHINE
  GEYSER
}

enum WorkHistoryEvent {
  PURCHASED
  INSTALLED
  REPAIR
  INSPECTION
  UNINSTALLED
  FILTER_CHANGE
}

// ─── Complaint Enums ──────────────────────────────────────────────────────────

enum ComplaintStage {
  ENTRANCE
  QR_VALIDATED
  ESTIMATION
  APPROVAL
  PAYMENT
  COMPLETED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Wallet Enums ─────────────────────────────────────────────────────────────

enum WalletType {
  CUSTOMER
  PROVIDER
}

enum WalletLedgerType {
  CREDIT
  DEBIT
}

enum WalletLedgerSource {
  RECHARGE
  ORDER_PAYMENT
  REFUND
  ADMIN_ADJUSTMENT
  CASHBACK
  TRANSFER
  WITHDRAWAL
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PaymentProvider {
  RAZORPAY
  ADMIN
  CASH
}

// ─── Payment Enums ────────────────────────────────────────────────────────────

enum PaymentOrderStatus {
  PENDING
  PROCESSING
  CAPTURED
  FAILED
}

// ─── Notification Enums ───────────────────────────────────────────────────────

enum NotificationType {
  SERVICE
  COMPLAINT
  GENERAL
  PAYMENT
  SECURITY
}

// ─── Subscription Enums ───────────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  ANNUAL
  MONTHLY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum DevicePlatform {
  ANDROID
  IOS
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id                   String           @id @default(uuid())
  phoneNo              String           @unique
  email                String?          @unique
  firstName            String?
  lastName             String?
  role                 Role             @default(CUSTOMER)
  avatar               String?
  referralCode         String?          @unique
  isActive             Boolean          @default(true)
  isDeleted            Boolean          @default(false)
  // Provider-only fields (skills, KYC addresses, admin notes) live on ProviderProfile,
  // not here — role: CUSTOMER/ADMIN rows would otherwise carry permanently-null cruft.
  providerProfile      ProviderProfile?
  refreshTokens        RefreshToken[]
  addresses            Address[]        @relation("UserAddresses")
  devices              Device[]
  // Complaint relations
  complaintsAsCustomer Complaint[]      @relation("CustomerComplaints")
  complaintsAsProvider Complaint[]      @relation("ProviderComplaints")
  // Notification relations
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  // Wallet relations
  wallet               Wallet?
  walletLedger         WalletLedger[]
  payoutRequests       PayoutRequest[]
  // Payment relations
  paymentOrders        PaymentOrder[]
  paymentSessions      PaymentSession[]
  // Subscription relations
  subscriptions        Subscription[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([phoneNo])
  @@index([referralCode])
}

// Provider-only profile data, split off User so CUSTOMER/ADMIN rows never
// carry these fields as permanent nulls. One-to-one with User via userId.
model ProviderProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id])
  // Device types this provider is skilled to service
  skills           DeviceType[] @default([])
  currentAddressId String?      @unique
  currentAddress   Address?     @relation("ProviderCurrentAddress", fields: [currentAddressId], references: [id])
  aadharAddressId  String?      @unique
  aadharAddress    Address?     @relation("ProviderAadharAddress", fields: [aadharAddressId], references: [id])
  adminNotes       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Otp {
  id        String   @id @default(uuid())
  phoneNo   String   @unique
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phoneNo])
}

model Address {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation("UserAddresses", fields: [userId], references: [id])
  // Reverse side of a provider's two dedicated address slots (see ProviderProfile.currentAddress / aadharAddress).
  providerCurrentFor ProviderProfile? @relation("ProviderCurrentAddress")
  providerAadharFor  ProviderProfile? @relation("ProviderAadharAddress")
  title              String?
  houseNo            String
  societyName        String
  addressLineOne     String?
  addressLineTwo     String?
  area               String?
  pinCode            String?
  city               String?
  state              String?
  country            String           @default("India")
  latitude           String?
  longitude          String?
  directionNote      String?
  complaints         Complaint[]
  devices            Device[]
  isDeleted          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId, isDeleted])
}

model Device {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  addressId   String?
  address     Address?            @relation(fields: [addressId], references: [id])
  // slug that maps to a Strapi content-type, e.g. "master_purifier"
  deviceKey   String
  type        DeviceType
  imageUrl    String?
  metadata    Json
  workHistory DeviceWorkHistory[]
  complaints  Complaint[]
  isDeleted   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId, isDeleted])
  @@index([deviceKey])
  @@index([addressId])
}

model DeviceWorkHistory {
  id        String           @id @default(uuid())
  deviceId  String
  device    Device           @relation(fields: [deviceId], references: [id])
  event     WorkHistoryEvent
  eventDate DateTime
  notes     String?
  isDeleted Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([deviceId, isDeleted])
  @@index([deviceId, event])
}

// ─── Complaint Models ─────────────────────────────────────────────────────────

model Complaint {
  id         String         @id @default(uuid())
  userId     String
  providerId String?
  addressId  String
  deviceId   String?
  // Strapi content-type slug for the linked device type
  deviceKey  String?
  title      String
  notes      String?
  stage      ComplaintStage @default(ENTRANCE)

  // Provider assignment tracking
  providerAccepted    Boolean   @default(false)
  providerAcceptedAt  DateTime?
  rejectedProviderIds String[]  @default([])

  // Physical entry QR (10-min expiry, provider scans on-site)
  entryQrToken     String?   @unique
  entryQrExpiresAt DateTime?

  // Rejection metadata
  rejectionReason String?
  rejectedAt      DateTime?
  rejectedBy      String?

  // Reopen chain — parentId links to the original closed complaint
  parentId String?

  // Subscription — if this complaint is covered under a subscription visit
  subscriptionId String?

  // Relations
  user          User             @relation("CustomerComplaints", fields: [userId], references: [id])
  provider      User?            @relation("ProviderComplaints", fields: [providerId], references: [id])
  address       Address          @relation(fields: [addressId], references: [id])
  device        Device?          @relation(fields: [deviceId], references: [id])
  parent        Complaint?       @relation("ComplaintReopened", fields: [parentId], references: [id])
  children      Complaint[]      @relation("ComplaintReopened")
  subscription  Subscription?    @relation(fields: [subscriptionId], references: [id])
  media         ComplaintMedia[]
  quote         Quote?
  notifications Notification[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDeleted])
  @@index([providerId, isDeleted])
  @@index([stage])
  @@index([parentId])
  @@index([entryQrToken])
  @@index([subscriptionId])
}

model ComplaintMedia {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  url         String
  type        MediaType @default(IMAGE)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([complaintId])
}

model Quote {
  id          String      @id @default(uuid())
  complaintId String      @unique
  complaint   Complaint   @relation(fields: [complaintId], references: [id])
  items       Json // [{ description: string, amount: number }]
  totalAmount Float       @default(0)
  notes       String?
  status      QuoteStatus @default(PENDING)
  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([complaintId])
}

// ─── Notification Models ──────────────────────────────────────────────────────

model Notification {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  complaintId String?
  complaint   Complaint?         @relation(fields: [complaintId], references: [id])
  title       String
  body        String
  type        NotificationType   @default(SERVICE)
  status      NotificationStatus @default(PENDING)
  metadata    Json?
  isRead      Boolean            @default(false)
  isDeleted   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, isDeleted])
  @@index([complaintId])
}

// ─── Wallet Models ────────────────────────────────────────────────────────────

model Wallet {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  // walletType: CUSTOMER wallets are in-app spend/top-up balances; PROVIDER wallets are
  // accrued earnings that will eventually be withdrawn. Derived from User.role at creation.
  walletType     WalletType
  balance        Float           @default(0)
  isActive       Boolean         @default(true)
  isDeleted      Boolean         @default(false)
  ledger         WalletLedger[]
  payoutRequests PayoutRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([walletType])
}

model WalletLedger {
  id              String             @id @default(uuid())
  walletId        String
  wallet          Wallet             @relation(fields: [walletId], references: [id])
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  type            WalletLedgerType
  source          WalletLedgerSource
  amount          Float
  openingBalance  Float
  closingBalance  Float
  refId           String?
  meta            Json?
  // payment_provider: tracks which payment channel originated this entry
  paymentProvider PaymentProvider?
  // updateBalance: false means the entry is audit-only — wallet.balance was NOT changed
  updateBalance   Boolean            @default(true)
  isDeleted       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([walletId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// PayoutRequest: provider withdrawal requests against their earnings Wallet.
// bankAccountRef is a placeholder until KYC/bank-account capture is built.
model PayoutRequest {
  id            String              @id @default(uuid())
  walletId      String
  wallet        Wallet              @relation(fields: [walletId], references: [id])
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  amount        Float
  status        PayoutRequestStatus @default(PENDING)
  bankAccountRef Json?
  adminId       String?
  processedAt   DateTime?
  isDeleted     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([walletId])
  @@index([userId, createdAt(sort: Desc)])
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  token     String         @unique
  platform  DevicePlatform
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@index([token])
}

// ─── Payment Order Model ──────────────────────────────────────────────────────

model PaymentOrder {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  razorpayOrderId   String             @unique
  amount            Int // in paise
  status            PaymentOrderStatus @default(PENDING)
  // purpose: "subscription" | "recharge" — drives fulfilment logic in webhook
  purpose           String
  // meta: snapshot of all data needed to fulfill the purpose after capture
  meta              Json
  razorpayPaymentId String? // populated after successful capture
  isDeleted         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, isDeleted])
  @@index([razorpayOrderId])
  @@index([status])
}

// ─── Payment Session Model ────────────────────────────────────────────────────
// Created before the WebView opens; webhook matches by phone + amount.

enum PaymentSessionStatus {
  PENDING
  FULFILLED
  EXPIRED
}

model PaymentSession {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  phone               String // user's phone, matched against webhook contact field
  purpose             String // subscription | recharge | complaint_payment
  expectedAmountPaise Int // amount in paise, verified against webhook payload
  meta                Json // subscription details, addon list, etc.
  status              PaymentSessionStatus @default(PENDING)
  expiresAt           DateTime // 30-minute window
  isDeleted           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([phone, status])
  @@index([userId, status])
  @@index([expiresAt])
}

// ─── Subscription Models ──────────────────────────────────────────────────────

model Subscription {
  id            String @id @default(uuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id])
  // Subscription covers all devices of this type for the user (e.g. "master_purifier")
  deviceTypeKey String

  // Plan snapshot captured at purchase time
  planKey        String // e.g. "LITE", "STANDARD", "COMPLETE"
  planName       String
  planBadgeColor String? // hex color from CMS badge_color
  billingCycle   BillingCycle
  planPrice      Float // base plan price before addons
  addons         Json         @default("[]") // [{ key, name, price }]
  totalAmount    Float // planPrice + sum(addon prices)

  // Dual expiry: whichever fires first ends the subscription
  maxServices  Int // -1 = unlimited (time-only expiry)
  servicesUsed Int      @default(0)
  startDate    DateTime
  endDate      DateTime

  status SubscriptionStatus @default(ACTIVE)

  services   SubscriptionService[]
  complaints Complaint[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDeleted])
  @@index([userId, deviceTypeKey, status])
  @@index([status, endDate])
}

model SubscriptionService {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  visitNumber    Int
  scheduledDate  DateTime? // informational estimated date for user
  completedDate  DateTime?
  complaintId    String? // set when complaint is raised against this visit
  serviceKeys    Json         @default("[]") // service-part keys included in this visit
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([subscriptionId])
}

// ─── OTA (hot-updater) Models ──────────────────────────────────────────────────
// NOTE: model/field names below are snake_case, breaking from this file's usual
// PascalCase-model / camelCase-field convention. This is required, not stylistic:
// hot-updater's own Prisma adapter (@hot-updater/server, adapters/prisma.ts) does
// `prisma["bundles"]` / `prisma["bundle_patches"]` and reads raw row keys like
// `row["target_app_version"]` directly, so the Prisma client's generated property
// names and returned row keys must literally match these strings. Scoped to only
// these two models — see d:\Serwise-bundle\ota-migration\TRACKING.md.

model bundles {
  id                     String           @id @default(uuid())
  platform               String
  should_force_update    Boolean
  enabled                Boolean
  file_hash              String
  git_commit_hash        String?
  message                String?
  channel                String           @default("production")
  storage_uri            String
  target_app_version     String?
  fingerprint_hash       String?
  metadata               Json             @default("{}")
  rollout_cohort_count   Int              @default(1000)
  target_cohorts         Json?
  manifest_storage_uri   String?
  manifest_file_hash     String?
  asset_base_storage_uri String?
  patches                bundle_patches[] @relation("bundle_patches_bundles_patches")

  @@index([target_app_version])
  @@index([fingerprint_hash])
  @@index([channel])
  @@index([rollout_cohort_count])
}

model bundle_patches {
  id                String  @id
  bundle_id         String
  base_bundle_id    String
  base_file_hash    String
  patch_file_hash   String
  patch_storage_uri String
  order_index       Int     @default(0)
  bundle            bundles @relation("bundle_patches_bundles_patches", fields: [bundle_id], references: [id])

  @@index([bundle_id])
  @@index([base_bundle_id])
}
